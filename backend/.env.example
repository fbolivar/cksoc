# ============================================================
#  Backend SOC PNNC - variables de entorno (ejemplo)
#  Copia este archivo a .env y completa los valores reales.
#  NUNCA subas el .env al repositorio.
# ============================================================

NODE_ENV=production
PORT=4000
# Origenes permitidos para CORS (en prod, mismo origen via Nginx). Coma-separado o *
CORS_ORIGIN=*

# --- PostgreSQL local ---
DATABASE_URL=postgresql://soc_app:CAMBIA_ESTA_CLAVE@127.0.0.1:5432/soc_pnnc

# --- Autenticacion ---
# Genera uno con: openssl rand -hex 32
JWT_SECRET=CAMBIA_ESTO_POR_UN_SECRETO_LARGO_Y_ALEATORIO
JWT_EXPIRES_IN=8h

# --- Wazuh Indexer (OpenSearch) ---
WAZUH_INDEXER_URL=https://192.168.50.5:9200
WAZUH_INDEXER_USER=admin
WAZUH_INDEXER_PASSWORD=CAMBIA_ESTA_CLAVE
WAZUH_ALERTS_INDEX=wazuh-alerts-*

# --- Wazuh API REST (gestion - Fases siguientes) ---
WAZUH_API_URL=https://192.168.50.5:55000
WAZUH_API_USER=wazuh-wui
WAZUH_API_PASSWORD=CAMBIA_ESTA_CLAVE

# TLS self-signed de Wazuh: en red interna normalmente false
WAZUH_TLS_REJECT_UNAUTHORIZED=false

# --- Notificaciones (Fase 3) ---
# SMTP para correo transaccional
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=SOC PNNC <soc@parquesnacionales.gov.co>
# Telegram: token del bot (crear con @BotFather). El chat_id se define por regla.
TELEGRAM_BOT_TOKEN=

# --- Reportes (Fase 4) ---
REPORT_DIR=./reports
REPORT_SCHEDULE_ENABLED=true
REPORT_SCHEDULE_CRON=0 7 * * *
REPORT_SCHEDULE_RANGE=24h
# Correos (separados por coma) que reciben el reporte programado (opcional, requiere SMTP)
REPORT_EMAIL_TO=
# Ruta a Chromium si no se usa el de Puppeteer (opcional)
PUPPETEER_EXECUTABLE_PATH=
